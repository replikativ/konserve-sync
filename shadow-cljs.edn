{:deps {:aliases [:cljs-test]}
 :builds
 {:test
  {:target :node-test
   :output-to "target/test.js"
   :ns-regexp "-test$"
   :autorun true}

  ;; The CBOR transport on ClojureScript. Needs the :cbor deps alias
  ;; for test-cbor/ plus the kabel and konserve branches, so run it as
  ;;
  ;;   npx shadow-cljs -A:cbor compile cbor-test
  ;;
  ;; Deps aliases in shadow-cljs.edn are global, which is why :cbor is passed
  ;; on the command line instead: adding it here would silently move the :test
  ;; build onto those branches too.
  :cbor-test
  {:target :node-test
   :output-to "target/cbor-test.js"
   :ns-regexp "-node-test$"
   :autorun true}}}
