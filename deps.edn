{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.11.1"}
  org.replikativ/konserve {:mvn/version "0.9.350"}
  org.replikativ/hasch {:mvn/version "0.3.96"}
  org.replikativ/superv.async {:mvn/version "0.3.50"}
  com.taoensso/trove {:mvn/version "1.1.0"}
  org.replikativ/kabel {:mvn/version "0.3.100"}}

 :aliases
 {:dev
  {:extra-paths ["test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                ;; Optional dep for datahike walker tests (includes persistent-sorted-set)
                org.replikativ/datahike {:mvn/version "0.8.1729"}}
   :main-opts ["-m" "kaocha.runner"]}

  :cljs-test
  {:extra-paths ["test"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "2.26.0"}}}

  ;; Verification of konserve-sync over the boring (CBOR) transport. Nothing in
  ;; src/ changes -- konserve-sync takes the serialization middleware as an
  ;; argument -- so this is an extra test path, not a new dependency of the
  ;; library.
  ;;
  ;; kabel and konserve are :local/root because the boring middleware (frame 14)
  ;; and the boring serializer (byte 3) are on branches at the time of writing.
  ;; Once both are released this becomes two :mvn/version bumps and the alias
  ;; can fold into :test.
  ;;
  ;;   clj -M:boring -m kaocha.runner --config-file tests-boring.edn
  :boring
  {:extra-paths ["test-boring"]
   :override-deps {org.replikativ/kabel {:local/root "../kabel"}
                   org.replikativ/konserve {:local/root "../konserve"}
                   ;; Pinned, not inherited. konserve's `com.github.pkpkpk/fress`
                   ;; drags in ClojureScript 1.12.145, which brings
                   ;; google-closure-library 0.0-20250515 while shadow-cljs
                   ;; still ships closure-compiler v20240317. That combination
                   ;; COMPILES CLEANLY and then dies at runtime with
                   ;; "goog.reflect.cache is not a function", so a green build
                   ;; is not evidence here -- the node test has to be executed.
                   ;; 1.11.132 + shadow 2.28.20 is the pairing kabel's own cljs
                   ;; tests run on.
                   org.clojure/clojurescript {:mvn/version "1.11.132"}
                   thheller/shadow-cljs {:mvn/version "2.28.20"}}
   :extra-deps {org.replikativ/boring {:local/root "../boring"}
                lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}
          io.github.borkdude/gh-release-artifact {:git/sha "05f8d8659e6805d513c59447ff41dc8497878462"}
          babashka/babashka.curl {:mvn/version "0.1.2"}
          babashka/fs {:mvn/version "0.1.6"}
          cheshire/cheshire {:mvn/version "5.10.2"}}
   :ns-default build}

  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix"]}}}
