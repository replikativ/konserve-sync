{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.11.1"}
  org.replikativ/konserve {:mvn/version "0.9.350"}
  org.replikativ/hasch {:mvn/version "0.3.96"}
  org.replikativ/superv.async {:mvn/version "0.3.50"}
  com.taoensso/trove {:mvn/version "1.1.0"}
  org.replikativ/kabel {:mvn/version "0.3.100"}}

 :aliases
 {:dev
  {:extra-paths ["test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                ;; Optional dep for datahike walker tests (includes persistent-sorted-set)
                org.replikativ/datahike {:mvn/version "0.8.1729"}}
   :main-opts ["-m" "kaocha.runner"]}

  :cljs-test
  {:extra-paths ["test"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.4.11"}}}

  ;; Verification of konserve-sync over the CBOR transport. Nothing in
  ;; src/ changes -- konserve-sync takes the serialization middleware as an
  ;; argument -- so this is an extra test path, not a new dependency of the
  ;; library.
  ;;
  ;; boring and konserve are released coordinates now -- boring 0.1.4 on
  ;; Clojars, and konserve 0.9.364 carries the byte-3 serializer (replikativ/
  ;; konserve#160, merged). kabel stays :local/root until its CBOR middleware
  ;; PR (replikativ/kabel#15) lands; once it does this alias folds into :test.
  ;;
  ;;   clj -M:cbor -m kaocha.runner --config-file tests-cbor.edn
  :cbor
  {:extra-paths ["test-cbor"]
   :override-deps {org.replikativ/kabel {:local/root "../kabel"}
                   org.replikativ/konserve {:mvn/version "0.9.364"}
                   ;; ClojureScript and shadow-cljs must be a MATCHED pair: each
                   ;; pulls a google-closure-library, and a mismatched pair
                   ;; compiles cleanly and then dies at RUNTIME with
                   ;; "goog.reflect.cache is not a function". A green build is not
                   ;; evidence here; the node test has to be executed. Both are
                   ;; the current release.
                   org.clojure/clojurescript {:mvn/version "1.12.145"}
                   thheller/shadow-cljs {:mvn/version "3.4.11"}}
   :extra-deps {org.replikativ/boring {:mvn/version "0.1.4"}
                lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}
          io.github.borkdude/gh-release-artifact {:git/sha "05f8d8659e6805d513c59447ff41dc8497878462"}
          babashka/babashka.curl {:mvn/version "0.1.2"}
          babashka/fs {:mvn/version "0.1.6"}
          cheshire/cheshire {:mvn/version "5.10.2"}}
   :ns-default build}

  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix"]}}}
