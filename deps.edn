{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.11.1"}
  org.replikativ/konserve {:mvn/version "0.9.365"}
  org.replikativ/hasch {:mvn/version "0.3.96"}
  org.replikativ/superv.async {:mvn/version "0.3.50"}
  com.taoensso/trove {:mvn/version "1.1.0"}
  org.replikativ/kabel {:mvn/version "0.3.116"}}

 :aliases
 {:dev
  {:extra-paths ["test"]}

  :test
  ;; test-cbor/ carries the CBOR-transport verification. It used to need its own
  ;; alias because kabel's CBOR middleware was unreleased; kabel 0.3.102 ships it,
  ;; so the only thing that path still needs is boring, and it belongs in the
  ;; ordinary suite rather than a side channel nobody runs.
  {:extra-paths ["test" "test-cbor"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                org.replikativ/boring {:mvn/version "0.1.17"}
                ;; Optional dep for datahike walker tests (includes persistent-sorted-set)
                org.replikativ/datahike {:mvn/version "0.8.1729"}}
   :main-opts ["-m" "kaocha.runner"]}

  :cljs-test
  ;; ClojureScript and shadow-cljs must be a MATCHED pair: each pulls a
  ;; google-closure-library, and a mismatched pair compiles cleanly and then dies
  ;; at RUNTIME with "goog.reflect.cache is not a function". A green build is not
  ;; evidence here; the node test has to be executed.
  {:extra-paths ["test" "test-cbor"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.4.11"}
                org.clojure/clojurescript {:mvn/version "1.12.145"}
                org.replikativ/boring {:mvn/version "0.1.17"}}}

  ;; konserve-sync over Netz's peer-to-peer overlay rather than a single
  ;; connection. `StoreSyncStrategy` already expresses both the live path
  ;; (-apply-publish) and a differential state sync
  ;; (-init-client-state -> -handshake-items -> -apply-handshake-item), and
  ;; those were never the transport's business. So federation is a transport
  ;; swap, and this alias is the evidence.
  ;;
  ;; Local root until Netz's first alpha is published.
  ;;
  ;;   clojure -X:overlay:test :dirs '["test-overlay"]'
  :overlay
  {:extra-paths ["test-overlay"]
   ;; hasch 0.4 as well: geheimnis (and so Netz) uses `hasch/sha256`,
   ;; which 0.3 does not have. konserve-sync's own pin moves when it releases
   ;; against the overlay.
   :override-deps {org.replikativ/hasch {:mvn/version "0.4.100"}}
   :extra-deps {org.replikativ/netz {:local/root "../netz"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}
          io.github.borkdude/gh-release-artifact {:git/sha "05f8d8659e6805d513c59447ff41dc8497878462"}
          babashka/babashka.curl {:mvn/version "0.1.2"}
          babashka/fs {:mvn/version "0.1.6"}
          cheshire/cheshire {:mvn/version "5.10.2"}}
   :ns-default build}

  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix"]}}}
